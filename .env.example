# Copy this file to .env for local development. Never commit your real .env.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leaving these empty uses a development-only key and a local SQLite database.
DJANGO_SECRET_KEY=
DATABASE_URL=

# For a local PostgreSQL server only; production must use True.
DATABASE_SSL_REQUIRE=False
